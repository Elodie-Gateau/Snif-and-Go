{% extends 'base.html.twig' %}

{% block page_scripts %}
  {{ importmap('global') }}
{% endblock %}


{% block title %}Inscription à une balade
{% endblock %}

{% block body %}
	<section class="walk-register">
		<h1 class="walk-register__title">Valider l'inscription</h1>

		<div class="walk-register__desc">
			<h2 class="walk-register__subtitle">Balade du
				{{ walk.date|format_datetime('full', 'short', locale: 'fr')  }}</h2>

			<div class="walk-register__desc-item">
				<p class="walk-register__desc-title">Organisa{{ walk.user.title == "Mme" ? "trice" : "teur"}}</p>
				<p class="walk-register__desc-content">{{ walk.user.firstname }} {{ walk.user.name }}</p>
			</div>
			<div class="walk-register__desc-item">
				<p class="walk-register__desc-title">Itinéraire</p>
				<p class="walk-register__desc-content">{{ walk.trail.name }}</p>
			</div>
			<div class="walk-register__desc-item">
				<p class="walk-register__desc-title">Distance</p>
				<p class="walk-register__desc-content">{{ walk.trail.distance }}
					km{{ walk.trail.distance > 1 ? "s" : "" }}</p>
			</div>
			<div class="walk-register__desc-item">
				<p class="walk-register__desc-title">Durée</p>
				<p class="walk-register__desc-content">{% import 'macros/duration.html.twig' as dur %}
					{{ dur.minutes(walk.trail.duration) }}</p>
			</div>
			<div class="walk-register__desc-item">
				<p class="walk-register__desc-title">Difficulté</p>
				<p class="walk-register__desc-content">{% set difficultyLabels = {'easy': 'Facile','medium': 'Moyen','hard': 'Difficile'} %}
					{{ difficultyLabels[walk.trail.difficulty] ?? 'Non défini' }}</p>
			</div>
			<div class="walk-register__desc-item">
				<p class="walk-register__desc-title">Point d'eau</p>
					{% set waterPointLabels = {'true' : 'Oui', 'false' : 'Non'} %}
					<p class="walk-register__desc-content">{{ waterPointLabels[walk.trail.waterPoint] ?? 'Non renseigné' }}</p>
			</div>
			<div class="walk-register__desc-item">
				<p class="walk-register__desc-title">Point de départ</p>
				<div class="walk-register__desc-wrapper">
					<p class="walk-register__desc-content">{{ walk.trail.startAddress }}</p>
					<p class="walk-register__desc-content">{{ walk.trail.startCode }}</p>
					<p class="walk-register__desc-content">{{ walk.trail.startCity }}</p>
				</div>
			</div>
			<div class="walk-register__desc-item">
				<p class="walk-register__desc-title">Point d'arrivée</p>
				<div class="walk-register__desc-wrapper">
					<p class="walk-register__desc-content">{{ walk.trail.endAddress }}</p>
					<p class="walk-register__desc-content">{{ walk.trail.endCode }}</p>
					<p class="walk-register__desc-content">{{ walk.trail.endCity }}</p>
				</div>
			</div>

			<div class="walk-register__desc-item">
				<p class="walk-register__desc-title">Nombre de chien maximum</p>
				<p class="walk-register__desc-content">{{ walk.maxDogs }}</p>
			</div>
			<div class="walk-register__desc-item">
				<p class="walk-register__desc-title">Les chiens inscrits</p>
				<div class="walk-register__desc-wrapper">
					{% if validRegisters|length > 0 %}
						{% for register in validRegisters %}
							<div class="walk-register__desc-container">
								{% set dogPhotoClass = ['walk-register__dog-photo', register.dog.sex] | join(' ') %}
								{% if register.dog.photo %}
									<img loading="lazy"
													class="{{ dogPhotoClass }}"
													alt="Portrait de {{ register.dog.name }}"												
													{% if register.dog.cdnLink %}
													{% set id = register.dog.cdnLink ?? '' %}
													src="{{'https://res.cloudinary.com/dimexwbcu/image/upload/f_auto,q_auto:good,c_fill,g_face,r_max,w_160,h_160,dpr_auto/' ~ id }}"
													{% else %}
													src="{{ asset('uploads/images/' ~ register.dog.photo)}}"
													{% endif %}
													>
											{% else %}
												{{ ux_icon('streamline-plump:dog-1-remix', { class: dogPhotoClass }) }}
											{% endif %}
								<p class="walk-register__desc-content">{{ register.dog.name }}</p>
							</div>
						{% endfor %}

					{% else %}
						<p class="walk-register__desc-content">Aucun chien n'est encore inscrit à cette balade</p>
					{% endif %}
				</div>

			</div>

			{% if dogs|length > 0 %}
				{{ include('walk_registration/_form.html.twig') }}
			{% else %}
				<div class="walk-register__desc-more">
					<p class="walk-register__desc-content">Vous n'avez pas de chien(s) disponible(s) pour cette balade.</p>
					<p class="walk-register__desc-infos">Conformément aux
						<a class="walk-register__desc-link" href="{{path('app_mentions_legales')}}">conditions générales d'utilisation</a>, le numéro d'identification du chien (puce ou tatouage) est obligatoire pour s'inscrire à la balade.</p>
					<p class="walk-register__desc-infos">Si ce n'est pas encore fait, mettez à jour les informations sur votre chien en vous rendant sur votre
						<a class="walk-register__desc-link" href="{{ path('app_profile')}}">profil personnel</a>
					</p>
				</div>
			{% endif %}
			{% if app.user == walk.user %}
				<div class="walk-register__wrapper actions">
					<a class="walk-register__icon" href="{{ path('app_walk_edit', { 'id': walk.id }) }}">{{ ux_icon('fa:edit', {class: 'walk-register__icon'}) }}</a>
					<form method="post" action="{{ path('app_walk_inactive', {'id': walk.id}) }}">
						<input type="hidden" name="_token" value="notoken">
						<button class="js-delete walk-register__icon" data-url="{{ path('app_walk_inactive', {'id': walk.id}) }}" data-token="notoken" data-name="la balade du {{ walk.date|format_datetime('full', 'short', locale: 'fr') }}" type="submit">
							{{ ux_icon('streamline-ultimate:bin-1-bold',{ class: 'profile__walks-icon' }) }}
						</button>
					</form>
				</div>
			{% endif %}
		</div>

		<a class="walk-register__back back" href="{{ path('app_home') }}">Retour</a>

	</section>
{% endblock %}
