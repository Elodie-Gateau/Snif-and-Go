{% extends 'base.html.twig' %}

{% block page_scripts %}
	<script src="{{ asset('js/trail-search.js') }}" defer data-turbo-track="reload"></script>
{% endblock %}


{% block title %}Snif &amp;Go
{% endblock %}

{% block body %}


	{# Page d'accueil pour utilisateurs connectés #}
	{% if app.user %}
		<section class="home-user">
			<h1 class="home-user__title">Bonjour
				{{ app.user.firstname }}
				{{ux_icon('fa6-solid:paw', {style: 'height: 1em'})}}</h1>
			<div class="home-user__container">
				<div class="home-user__wrapper">
					<div class="home-user__intro">
						<img class="home-user__intro-bg" 
							src="{{ asset('images/photo-accueil-user.webp') }}" 
							width="360" height="240" 
							fetchpriority="high" 
							decoding="async" 
							alt="Image d'un jeune chien qui sourit" 
							aria-hidden="true">
						<div class="home-user__intro-wrapper">
							<p class="home-user__intro-content">Bienvenue sur votre espace. Ici, vous pouvez accédez à toutes les fonctionnalités de Snif&nbsp;&amp;&nbsp;Go.
							</p>
							<p class="home-user__intro-content">Bonne balade&nbsp;!</p>
						</div>
					</div>

					<div class="home-user__dog">
						<div class="home-user__dog-wrapper">
							<h2 class="home-user__dog-title">Mes chiens</h2>
							<a class="home-user__button btn" href="{{ path('app_dog_new') }}">Ajouter</a>
						</div>

						{% if dogs|length > 0 %}
							<ul role="list" class="home-user__dog-container">
								{% for dog in dogs %}
									<li class="home-user__dog--card">
										<div class="home-user__dog-item">
											<a class="home-user__dog-edit-icon" aria-label="Modifier {{ dog.name }}" href="{{ path('app_dog_edit', {'id': dog.id}) }}">{{ ux_icon('fa:edit',{ class: 'home-user__dog-edit-icon' }) }}</a>
										</div>
										<div class="home-user__dog-photo-container">
											{% set dogPhotoClass = ['home-user__dog-photo', dog.sex] | join(' ') %}
											{% if dog.photo %}
												<img loading="lazy"
													class="{{ dogPhotoClass }}"
													alt="Portrait de {{ dog.name }}"												
													{% if dog.cdnLink %}
													src="https://res.cloudinary.com/dimexwbcu/image/upload/f_auto,q_auto,c_fill,w_275,h_160/{{dog.cdnLink}}"
													{% else %}
													src="{{ asset('uploads/images/' ~ dog.photo)}}"
													{% endif %}
													>
											{% else %}
												{{ ux_icon('streamline-plump:dog-1-remix', { class: dogPhotoClass }) }}
											{% endif %}
										</div>

										<p class="home-user__dog-name">{{ dog.name }}</p>

										{% if dogNextWalks|length > 0 and dogNextWalks[dog.id] %}
											<div class="home-user__dog-infos">
												<p class="home-user__dog-subtitle">{{ux_icon('fa6-solid:paw', {class: 'home-user__dog-icon'})}}
													Prochaine balade
													{{ux_icon('fa6-solid:paw', {class: 'home-user__dog-icon'})}}</p>
												<time datetime="{{ dogNextWalks[dog.id].walk.date|date('c') }}" class="home-user__dog-content">{{ dogNextWalks[dog.id].walk.date|format_datetime('medium','short', locale='fr')}}
													<a class="home-user__dog-link" aria-label="Voir la balade de {{ dog.name }}" href="{{ path('app_walk_registration_show', {'id': dogNextWalks[dog.id].id }) }}">{{ ux_icon('emojione-monotone:magnifying-glass-tilted-left', {class: 'home-user__dog-icon'}) }}</a>
												</time>
											</div>
										{% endif %}

									</li>
								{% endfor %}
							</ul>
							{% if hasMoreDogs %}
								<a class="home-user__button btn" href="{{ path('app_profile') }}">Voir plus</a>
							{% endif %}
						{% else %}
							<p>Aucun chien n'est encore inscrit</p>
						{% endif %}
					</div>
				</div>
				<div class="home-user__walk">
					<h2 class="home-user__walk-title">Les prochaines balades</h2>
					<ul role="list" class="home-user__walk-container">
						{% if nextWalks|length > 0 %}
							{% for walk in nextWalks %}
								<li class="home-user__walk--card">
									<div class="home-user__walk-wrapper">
										<time datetime="{{ walk.date|date('c') }}" class="home-user__walk-accent">{{ walk.date|format_datetime('medium', 'short', locale: 'fr') }}</time>
										<div class="home-user__walk-item">
											<a href="{{ path('app_trail_show', {id:walk.trail.id})}}" class="walk__content">
												<strong>{{ walk.trail.name }}</strong>
											</a>
											<p class="home-user__walk-content">{{ walk.trail.startCity }}</p>
										</div>
									</div>
									<div class="home-user__walk-wrapper">
										{% set spots = spotsByWalk[walk.id]  %}
										<a class="home-user__button {{ spots > 0 ? " btn" : " disable btn" }}" href="{{ path('app_walk_registration_new', { walkId: walk.id }) }}">{{ spots > 0 ? "S'inscrire" : "Complet" }}</a>

										<p class="home-user__walk-accent">{{ spots }}
											place{{ spots > 1 ? "s" : "" }}
											restante{{ spots > 1 ? "s" : "" }}
										</p>
									</div>
								</li>
							{% endfor %}
						</ul>
					{% else %}
						<p>Aucune balade prévue</p>
					{% endif %}

					{% if hasMoreWalks %}
						<a class="home-user__button btn" href="{{ path('app_walk_index') }}">Voir plus</a>
					{% endif %}
				</div>
			</div>
		</div>
		<div class="home-user__trail">
			<div class="home-user__trail-wrapper">
				<h2 class="home-user__trail-title">Rechercher une balade</h2>
				<a class="home-user__button btn" href="{{ path('app_trail_new') }}">Ajouter un itinéraire</a>
			</div>

			<div
				class="home-user__trail-search">

				{# Formulaire de recherche de trail #}
				{{ form_start(form, {method: 'post',action: path('app_home'),attr: { class: 'home-user__trail-form', 'data-turbo': 'false' }}) }}
				<div class="home-user__trail-search-bar">

					{{ form_widget(form.search, {'id': 'search-trails-home',attr: { 'data-url': path('app_trail_live_search'), 'autocomplete': 'off' }}) }}

					<div class="home-user__trail-search-item">
						<button class="home-user__trail-search--button btn">Rechercher</button>

						<button class="home-user__trail-search--link" type="button" id="toggle-advanced" aria-expanded="false" aria-controls="trail-advanced">
							Afficher plus de critères
						</button>
						<a class="home-user__trail-reset" aria-label="Réinitialiser la recherche" href="{{ path('app_home') }}">{{ ux_icon('system-uicons:reset', {class:'home-user__trail-icon'}) }}</a>
					</div>
				</div>

				{# Filtres de recherche avancés #}
				<div id="trail-advanced" class="home-user__trail-search--advanced hidden">
					<fieldset aria-describedby="filtres-help">
						<legend>Filtres avancés</legend>
						<p id="filtres-help" class="visually-hidden">Choisissez distance, durée et difficulté</p>
						<div class="home-user__trail-search--advanced-item">
							{{ form_label(form.difficulty)}}
							{{ form_widget(form.difficulty)}}
							{% if form_errors(form.difficulty) %}
								<div class="home-user__trail-search--advanced form__error">
									{{ form_errors(form.difficulty)}}
								</div>
							{% endif %}
						</div>

						<div class="home-user__trail-search--advanced-item">
							{{ form_label(form.minDistance)}}
							{{ form_widget(form.minDistance)}}
							{% if form_errors(form.minDistance) %}
								<div class="home-user__trail-search--advanced form__error">
									{{ form_errors(form.minDistance)}}
								</div>
							{% endif %}
						</div>

						<div class="home-user__trail-search--advanced-item">
							{{ form_label(form.maxDistance)}}
							{{ form_widget(form.maxDistance)}}
							{% if form_errors(form.maxDistance) %}
								<div class="home-user__trail-search--advanced form__error">
									{{ form_errors(form.maxDistance)}}
								</div>
							{% endif %}
						</div>

						<div class="home-user__trail-search--advanced-item">
							{{ form_label(form.minDuration)}}
							{{ form_widget(form.minDuration)}}
							{% if form_errors(form.minDuration) %}
								<div class="home-user__trail-search--advanced form__error">
									{{ form_errors(form.minDuration)}}
								</div>
							{% endif %}
						</div>

						<div class="home-user__trail-search--advanced-item">
							{{ form_label(form.maxDuration)}}
							{{ form_widget(form.maxDuration)}}
							{% if form_errors(form.maxDuration) %}
								<div class="home-user__trail-search--advanced form__error">
									{{ form_errors(form.maxDuration)}}
								</div>
							{% endif %}
						</div>
						{# 
						<div class="home-user__trail-search--advanced-item">
							{{ form_label(form.minScore)}}
							{{ form_widget(form.minScore)}}
							{% if form_errors(form.minScore) %}
								<div class="home-user__trail-search--advanced-error">
									{{ form_errors(form.minScore)}}
								</div>
							{% endif %}
						</div>

						<div class="home-user__trail-search--advanced-item">
							{{ form_label(form.maxScore)}}
							{{ form_widget(form.maxScore)}}
							{% if form_errors(form.maxScore) %}
								<div class="home-user__trail-search--advanced-error">
									{{ form_errors(form.maxScore)}}
								</div>
							{% endif %}
						</div> #}
						<div class="home-user__trail-search--advanced-button">
							<button class="home-user__button btn">Rechercher</button>
						</div>
					</div>
					{{ form_end(form) }}
				</fieldset>
			</div>

			{# Compteur de résultats #}
			{# <p id="search-result-count" role="status" aria-live="polite" class="visually-hidden"></p> #}

			{# Résultats #}
				<ul class="home-user__trail-search--results" role="list" aria-label="Résultats de recherche" aria-relevant="additions removals"> {% if foundTrails is defined and foundTrails|length > 0 %}
					{% for trail in foundTrails %}
						{% if trail.status == "Active" %}
							<li class="home-user__trail-card">
								{% if trail.photos|length > 0 %}
									<img loading="lazy" 
									decoding="async" 
									width="275" 
									height="160" 
									class="home-user__trail-photo" 
										{% if trail.photos[0].cdnLink %}
													src="https://res.cloudinary.com/dimexwbcu/image/upload/f_auto,q_auto,c_fill,w_275,h_160/{{trail.photos[0].cdnLink}}"
													{% else %}
													src="{{ asset('uploads/images/' ~ trail.photos[0].name)}}"
													{% endif %}
									alt="Photo de l'itinéraire {{ trail.name }}">
								{% else %}
									<img loading="lazy" decoding="async" width = "275" height="160" class="home-user__trail-photo" src="{{ asset('images/photo-trail-default.webp') }}" alt="Photo d'une carte routière'">
								{% endif %}
								<p class="home-user__trail-name">
									<strong>{{ trail.name }}</strong>
								</p>

								<div class="home-user__trail-description">
									<div class="home-user__trail-item">
										{{ux_icon('material-symbols:distance-rounded', {class: 'home-user__trail-icon'})}}
										<p class="home-user__trail-content">{{ trail.startCity }}
										</p>
									</div>
									<div class="home-user__trail-description">
										<div class="home-user__trail-item">
											{{ux_icon('game-icons:path-distance', {class: 'home-user__trail-icon'})}}
											<p class="home-user__trail-content">{{ trail.distance|round }}
												km{{ trail.distance > 1 ? "s" : "" }}</p>
										</div>
										<div class="home-user__trail-item">
											{{ux_icon('mingcute:time-fill', {class: 'home-user__trail-icon'})}}
											<p class="home-user__trail-content">{% import 'macros/duration.html.twig' as dur %}
												{{ dur.minutes(trail.duration) }}</p>
										</div>
										<div class="home-user__trail-item">
											{{ux_icon('game-icons:strong', {class: 'home-user__trail-icon'})}}

											{% set difficultyLabels = {'easy': 'Facile','medium': 'Moyen','hard': 'Difficile'} %}
											<p class="home-user__trail-content">{{ difficultyLabels[trail.difficulty] ?? 'Non défini' }}</p>
										</div>
										{% if trail.score %}
											<div class="home-user__trail-item">
												{{ux_icon('mdi:like', {class: 'home-user__trail-icon'})}}
												<div class="home-user__trail-content">

													{% for i in 1.. trail.score %}
														{{ux_icon('material-symbols:star-rounded', {class: 'home-user__trail-score'})}}
													{% endfor %}
													{% for i in 1.. (5 - trail.score) %}
														{{ux_icon('material-symbols:star-outline-rounded', {class: 'home-user__trail-score'})}}
													{% endfor %}
												</div>
											</div>
										{% endif %}
									</div>
									<a class="home-user__button btn" href="{{ path('app_trail_show', {id: trail.id}) }}">Consulter l'itinéraire</a>

								</li>


							{% endif %}
						{% endfor %}

					{% else %}
						<li class="home-user__trail-result-info">
							Aucun itinéraire trouvé, veuillez ajuster vos critères de recherche</li>

					{% endif %}
				</ul>

			</div>
			{% if hasMoreTrails|length > 0 %}
				<a class="home-user__button btn" href="{{ path('app_trail_index') }}">Voir plus</a>
			{% endif %}
		</section>

		{# Page d'accueil pour visiteurs non connectés #}
	{% else %}
		<section class="home-guest">
			<div class="home-guest__hero">
				<img class="home-guest__hero photo" src="{{ asset('images/hero-picture.webp') }}" 

				fetchpriority="high" 
				decoding="async" 
				alt="Deux femmes se baladent avec leurs chiens.">
				<h1 class="home-guest__hero-title">Bienvenue sur Snif &amp;Go</h1>
				<h2 class="home-guest__hero-subtitle">Plus de chiens, plus de fun !</h2>
			</div>

			<div class="home-guest__intro">
				<div class="home-guest__intro-container">
					<img loading="lazy" decoding="async"
						class="home-guest__intro-img"
						src="{{ asset('images/capture-homelog.webp') }}"
						
						alt="Capture d'écran du site Snif &amp;Go">
					<img loading="lazy" decoding="async"
						class="home-guest__intro-img"
						src="{{ asset('images/capture-home.webp') }}"
						
						alt="Capture d'écran du site Snif &amp;Go">	
				</div>
				{# <div class="home-guest__intro-description"> #}
					<p class="home-guest__intro-content">Snif &amp;Go est une plateforme communautaire où chaque utilisateur peut créer un compte, inscrire son chien et participer à des balades organisées par d'autres membres.</p>
					<p class="home-guest__intro-content">
						<strong>L'idée : transformer la promenade quotidienne en moment de partage et de convivialité.</strong>
					</p>

					<p class="home-guest__intro-content">Grâce à une carte collaborative, découvrez et proposez des itinéraires adaptés aux chiens. Chaque balade précise le nombre maximum de chiens autorisés afin de garantir confort et sécurité pour tous.</p>

					<p class="home-guest__intro-content">Plus qu'une application, Snif &amp;Go favorise les rencontres : entre maîtres, entre chiens et avec votre environnement local. Offrez à votre compagnon des sorties enrichissantes, et élargissez votre cercle autour d'une passion commune.</p>
				</div>

				<img loading="lazy" class="home-guest__intro photo" src="{{ asset('images/photo-intro.webp') }}" alt="Un homme et une femme se baladent avec leur chien">
			{# </div> #}

			<div class="home-guest__cta">
				<a class="home-guest__cta-button btn" href="{{ path('app_register') }}">Créer mon compte</a>
			</div>
		</section>
	{% endif %}
{% endblock %}
