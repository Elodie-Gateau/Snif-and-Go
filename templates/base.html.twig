<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Snif &amp; Go{% endblock %}
		</title>
		{% block meta_description %}
			<meta name="description" content="Snif &amp; Go : 
			trouvez et partagez des itinéraires de promenade pour chiens, près de chez vous. 
			Inscrivez-vous avec vos chiens pour des rendez-vous à ne pas manquer !">
		{% endblock %}
		<link rel="icon" type="image/png" href="{{ asset('icons/image.png') }}">
		{% block stylesheets %}
			<link rel="stylesheet" href="{{ asset('styles/app.scss') }}">

			<script src="https://cdn.jsdelivr.net/npm/leaflet-gpx@1.7.0/gpx.min.js" defer></script>
		{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}

	</head>
	<body>

		{# Skip link #}
		<a class="skip-link" href="#contenu">Aller au contenu</a>

		{# Header #}
		{% block header %}
			{% include 'layout/header.html.twig' %}
		{% endblock %}

		{# Main #}
		<main id="contenu" tabindex="-1">
			{% block flash %}
				<div class="flash">
					{% for label, messages in app.flashes %}
						{% for message in messages %}
							<div class="flash__{{label}}">
								{{ message }}
							</div>
						{% endfor %}
					{% endfor %}
				</div>
			{% endblock %}
			{% block body %}{% endblock %}
		</main>

		{# Footer #}
		{% block footer %}
			{% include 'layout/footer.html.twig' %}
		{% endblock %}

		{# Modale #}
		{% block modals %}
			{% include 'components/confirm_modal.html.twig' %}
		{% endblock %}
	</body>
</html>
