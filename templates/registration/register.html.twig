{% extends 'base.html.twig' %}
{% block page_scripts %}
  {{ importmap('global') }}
{% endblock %}

{% block title %}Créer un compte
{% endblock %}

{% block body %}
	<section class="register">
		<h1 class="register__title">Créer un compte</h1>

		{{ form_errors(registrationForm) }}
			{{ form_start(registrationForm) }}

			<div class="register form__item">
				{{ form_label(registrationForm.title) }}
				{{ form_widget(registrationForm.title) }}
			</div>
				{% if form_errors(registrationForm.title) %}
					<div class="register form__error">
						{{ form_errors(registrationForm.title) }}
					</div>
				{% endif %}
			

			<div class="register form__item">
				{{ form_label(registrationForm.name) }}
				{{ form_widget(registrationForm.name) }}
			</div>
				{% if form_errors(registrationForm.name) %}
					<div class="register form__error">
						{{ form_errors(registrationForm.name) }}
					</div>
				{% endif %}
			
			<div class="register form__item">
				{{ form_label(registrationForm.firstname) }}
				{{ form_widget(registrationForm.firstname) }}
			</div>
				{% if form_errors(registrationForm.firstname) %}
					<div class="register form__error">
						{{ form_errors(registrationForm.firstname) }}
					</div>
				{% endif %}
			
			<div class="register form__item">
				{{ form_label(registrationForm.email) }}
				{{ form_widget(registrationForm.email) }}
			</div>
				{% if form_errors(registrationForm.email) %}
					<div class="register form__error">
						{{ form_errors(registrationForm.email) }}
					</div>
				{% endif %}
			

			<div class="register form__item">
				{{ form_label(registrationForm.plainPassword) }}
				{{ form_widget(registrationForm.plainPassword) }}
			</div>
				{% if form_errors(registrationForm.plainPassword) %}
					<div class="register form__error">
						{{ form_errors(registrationForm.plainPassword) }}
					</div>
				{% endif %}
			
			<div class="register__form-item--terms">
				<label class="register__form-termes-label" for="{{ registrationForm.agreeTerms.vars.id }}">
					J'accepte les
					<a class="register__form-termes-link" href="{{ path('app_mentions_legales') }}" title="Cliquez ici pour lire les conditions en détail" target="_blank">conditions d'utilisation et la politique de confidentialité</a>
				</label>
				{{ form_widget(registrationForm.agreeTerms) }}
			</div>
				{% if form_errors(registrationForm.agreeTerms) %}
					<div class="register form__error">
						{{ form_errors(registrationForm.agreeTerms) }}
					</div>
				{% endif %}
			

			<div class="register__form-item--submit">
				<button type="submit" class="register__form-submit btn">S'inscrire</button>
			</div>
			{{ form_end(registrationForm) }}
	</section>
{% endblock %}
