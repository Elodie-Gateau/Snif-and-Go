<footer class="site-footer">
	<div class="site-footer__container">
		<img class="site-footer__logo-img" src="{{ asset('images/logos/logoWhite.webp') }}" alt="Logo de Snif &amp; Go">

		<nav class="site-footer__nav">
			<ul class="site-footer__menu">
                <li class="site-footer__item"><a class="site-footer__link" href="{{ path('app_home') }}">Accueil</a></li>
                {% if is_granted('ROLE_USER') %}
                <li class="site-footer__item"><a class="site-footer__link" href="{{ path('app_profile', {'id': app.user.id}) }}">Mon profil</a></li>
                {% if is_granted('ROLE_ADMIN') %}
                <li class="site-footer__item"><a class="site-footer__link" href="{{ path('admin_user_index') }}">Espace Administrateur</a></li>
                {% endif %}
                <li class="site-footer__item"><a class="site-footer__link" href="{{ path('app_logout') }}">Deconnexion</a></li>

                {% else %}
                <li class="site-footer__item"><a class="site-footer__link" href="{{ path('app_login') }}">Se connecter</a></li>
                <li class="site-footer__item"><a class="site-footer__link" href="{{ path('app_register') }}">S'inscrire</a></li>
                {% endif %}
			</ul>
		</nav>
	</div>
  <div class="site-footer__legal">
    <p class="site-footer__legal-item">© 2025 Snif &amp; Go - Tous droits réservés.</p> 
    <a class="site-footer__legal-item" href="{{ path('app_mentions_legales') }}">Mentions légales, CGU &amp; Politique de confidentialité</a>
  </div>
<div id="wcb" class="carbonbadge"></div>
<script src="https://unpkg.com/website-carbon-badges@1.1.3/b.min.js" defer></script>
</footer>
