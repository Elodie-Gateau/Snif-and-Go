{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe{% endblock %}

{% block body %}
<section class="password-edit">
    <h1>Modifier mon mot de passe</h1>
    <div class="user-edit__form form">
    {{ form_start(form) }}

    <div class="password-edit__item item">
    {{ form_label(form.currentPassword)}}
  {{ form_widget(form.currentPassword) }}
      {% if form_errors(form.currentPassword) %}
        <div class="password-edit__error">
            {{ form_errors(form.currentPassword) }}
        </div>
    {% endif %}
  </div>

    <div class="password-edit__item item">
    {{ form_label(form.plainPassword)}}
  {{ form_widget(form.plainPassword) }}
      {% if form_errors(form.plainPassword) %}
        <div class="password-edit__error">
            {{ form_errors(form.plainPassword) }}
        </div>
    {% endif %}
  </div>

  <button class="btn btn-primary">Mettre à jour</button>
{{ form_end(form) }}
</div>
</section>
{% endblock %}