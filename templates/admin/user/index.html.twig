{% extends 'base.html.twig' %}
{% block page_scripts %}
  {{ importmap('admin') }}
{% endblock %}
{% block title %}Espace administrateur
{% endblock %}

{% block body %}
	<section class="admin">
		<h1 class="admin__title">Espace administrateur</h1>

		{# NAVIGATION PANEL ADMIN #}
		<div class="admin__nav">
			<ul class="admin__list">
				<li class="admin__list-item">
					<a href="#users-list" id="btn-users-list" class="admin__list-link">
						<div class="admin__list-link--container">{{ ux_icon('mynaui:users-solid', {class: 'admin__nav-icon'}) }}
							{{ activeUsers|length }}</div>
						Utilisateurs</a>
				</li>
				<li class="admin__list-item">
					<a href="#dogs-list" id="btn-dogs-list"  class="admin__list-link">
						<div class="admin__list-link--container">{{ ux_icon('mdi:paw', {class: 'admin__nav-icon'}) }}
							{{ activeDogs|length }}</div>
						Chiens</a>
				</li>
				<li class="admin__list-item">
					<a href="#trails-list" id="btn-trails-list"  class="admin__list-link">
						<div class="admin__list-link--container">{{ ux_icon('streamline:arrow-roadmap', {class: 'admin__nav-icon'}) }}
							{{ activeTrails|length }}</div>
						Itinéraires</a>
				</li>
				<li class="admin__list-item">
					<a href="#walks-list" id="btn-walks-list"  class="admin__list-link">
						<div class="admin__list-link--container">{{ ux_icon('fa7-solid:dog', {class: 'admin__nav-icon'}) }}
							{{ activeWalks|length }}</div>
						Balades</a>
				</li>
			</ul>
		</div>

			{# GESTION DES USERS #}
			<div id="users-list" class="admin__users">
				<h2 class="admin__users-title">Utilisateurs</h2>
				<table class="admin__users-table">
					<thead>
						<tr>
							<th>Civilité</th>
							<th>Prénom</th>
							<th>Nom</th>
							<th>Email</th>
							<th>Rôle</th>
							<th>Statut</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for user in users %}
							<tr>
								<td data-label="Civilité">{{ user.title }}</td>
								<td data-label="Prénom">{{ user.firstname }}</td>
								<td data-label="Nom">{{ user.name }}</td>
								<td data-label="Email">{{ user.email }}</td>
								{% set roles = user.roles ?? [] %}
								<td data-label="Rôle">
									<p class="admin__users-roles {{ 'ROLE_ADMIN' in roles ? 'admin' : 'user' }}">
										{{ 'ROLE_ADMIN' in roles ? 'Administrateur' : 'Utilisateur' }}</p>
								</td>
								{% set status = {'Active' : 'Actif', 'Inactive' : 'Désactivé', 'Banned': 'Banni'} %}
								<td data-label="Statut">
									<p class="admin__users-status {{ user.status }}">
										{{ status[user.status] }}</p>
								</td>
								<td data-label="Actions">
									<div class="admin__users-wrapper">
										<a class="admin__users-icon" href="{{ path('admin_user_edit', {'id': user.id}) }}">{{ ux_icon('fa:edit',{ class: 'admin__users-icon' }) }}</a>
										<form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}">
											<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
											<button class="js-delete admin__users-icon" data-url="{{ path('admin_user_delete', {'id': user.id}) }}" data-token="{{ csrf_token('delete' ~ user.id) }}" data-name="{{ user.email }}" type="submit">
												{{ ux_icon('streamline-ultimate:bin-1-bold',{ class: 'admin__users-icon' }) }}
											</button>
										</form>

										{% if user.status != 'Banned' %}
											<form method="post" action="{{ path('admin_user_ban', {'id': user.id}) }}">
												<input type="hidden" name="_token" value="{{ csrf_token('ban' ~ user.id) }}">
												<button class="admin__users-icon" type="submit">
													{{ ux_icon('fa:ban',{ class: 'admin__users-ban-icon' }) }}
												</button>
											</form>
										{% else %}
											<form method="post" action="{{ path('admin_user_unban', {'id': user.id}) }}">
												<input type="hidden" name="_token" value="{{ csrf_token('unban' ~ user.id) }}">
												<button class="admin__users-icon" type="submit">
													{{ ux_icon('fa:check-circle',{ class: 'admin__users-unban-icon' }) }}
												</button>
											</form>
										{% endif %}
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			{# GESTION DES DOGS #}
		
			<div  id="dogs-list" class="admin__dogs hidden">
				<h2 class="admin__dogs-title">Chiens</h2>
				<table class="admin__dogs-table">
					<thead>
						<tr>
							<th>Nom</th>
							<th>Propriétaire</th>
							<th>Race</th>
							<th>Age</th>
							<th>Numéro d'identification</th>
							<th>Sexe</th>
							<th>Statut</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for dog in dogs %}
							<tr>
								<td data-label="Nom">{{ dog.name }}</td>
								<td data-label="Propriétaire">{{ dog.user.firstname ~' ' ~ dog.user.name ~' ' ~ dog.user.email }}</td>
								<td data-label="Race">{{ dog.dogBreed.nameFr }}</td>
								<td data-label="Âge">
									{% if dog.birthDate and dog.age >= 1 %}
										{{ dog.age }}
										an{{ dog.age > 1 ? "s" : "" }}
									{% endif %}
									{% if dog.birthDate and dog.age == 0 and dog.ageM >= 1 %}
										{{ dog.ageM }}
										mois
									{% endif %}
									{% if dog.birthDate and dog.age > 0 and dog.ageM > 0 %}
										{{ dog.ageM - (dog.age * 12) }}
										mois
									{% endif %}
								</td>
								<td data-label="Numéro d'identification">{{ dog.identityNumber }}</td>
								<td data-label="Sexe">
									{% set sexDogLabels = {'female': 'Femelle', 'male': 'Male'} %}
									{{ sexDogLabels[dog.sex] ?? 'Non renseigné' }}</td>
								{% set status = {'Active' : 'Actif', 'Inactive' : 'Désactivé'} %}
								<td data-label="Statut">
									<p class="admin__users-status {{ dog.status }}">
										{{ status[dog.status] }}</p>
								</td>
								<td data-label="Actions">
									<div class="admin__dogs-wrapper actions">
										<a class="admin__dogs-icon" href="{{ path('app_dog_edit', {'id': dog.id}) }}">{{ ux_icon('fa:edit',{ class: 'admin__dogs-edit-icon' }) }}</a>
										<form method="post" action="{{ path('app_dog_delete', {'id': dog.id}) }}">
											<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dog.id) }}">
											<button class="js-delete admin__dogs-icon" data-url="{{ path('app_dog_delete', {'id': dog.id}) }}" data-token="{{ csrf_token('delete' ~ dog.id) }}" data-name="{{ dog.name }}" type="submit">
												{{ ux_icon('streamline-ultimate:bin-1-bold',{ class: 'admin__users-icon' }) }}
											</button>
										</form>
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

		{# GESTION DES TRAILS #}
		
		
			<div  id="trails-list" class="admin__trails hidden">
				<h2 class="admin__trails-title">Itinéraires</h2>
			<form method="post" action="{{ path('app_trail_import_overpass') }}">
				<input type="text" name="city" placeholder="Ville (ex: La Roche-sur-Yon)" required>
			<input type="hidden" name="max_distance" value="15">
				<button type="submit" class="btn import-osm">
					{{ ux_icon('mdi:map-marker-path',{ class: 'admin__trails-icon' }) }}
					Importer depuis OSM (Vendée)
				</button>
			</form>
				<table class="admin__trails-table">
					<thead>
						<tr>
							<th>Nom</th>
							<th>Distance</th>
							<th>Durée</th>
							<th>Difficulté</th>
							<th>Point d'eau</th>
							<th>Score</th>
							<th>Créateur</th>
							<th>Ville de départ</th>
							<th>Ville d'arrivée</th>
							<th>Fichier GPX</th>
							<th>Statut</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for trail in trails %}
							<tr>
								<td data-label="Nom">
									<a href="{{ path('app_trail_show', {id: trail.id}) }}">{{ trail.name }}</a>
								</td>
								<td data-label="Distance">{{ trail.distance|round }}
									km{{ trail.distance > 1 ? "s" : "" }}</td>
								<td data-label="Durée">{% import 'macros/duration.html.twig' as dur %}
									{{ dur.minutes(trail.duration) }}</td>
								<td data-label="Difficulté">
									{% set difficultyLabels = {'easy': 'Facile','medium': 'Moyen','hard': 'Difficile'} %}
									{{ difficultyLabels[trail.difficulty] ?? 'Non défini' }}</td>
								{% set waterpointLabels = {'true': 'Oui','false': 'Non'} %}
								<td data-label="Point d'eau">{{ waterpointLabels[trail.waterPoint] ?? "Non défini" }}</td>
								<td data-label="Score">{{ trail.score }}</td>
								<td data-label="Créateur">{{ trail.user.firstname ~' ' ~ trail.user.name}}</td>
								<td data-label="Ville de départ">{{ trail.startCity }}</td>
								<td data-label="Ville d'arrivée">{{ trail.endCity }}</td>

								<td data-label="Fichier GPX">
									{% if trail.gpxFile %}
										<a class="trail__desc-link" href="{{ asset('uploads/gpx/' ~ trail.gpxFile) }}" download>
											{{ trail.gpxFile }}</a>
									{% endif %}
								</td>

								{% set status = {'Active' : 'Actif', 'Inactive' : 'Désactivé'} %}
								<td data-label="Statut">{{ status[trail.status] }}</td>
								<td data-label="Actions">
									<div class="admin__trails-wrapper">
										<a class="admin__trails-icon" href="{{ path('app_trail_edit', {'id': trail.id}) }}">{{ ux_icon('fa:edit',{ class: 'admin__trails-edit-icon' }) }}</a>
					<form method="post" action="{{ path('app_trail_delete', {'id': trail.id}) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ trail.id) }}">
						<button class="js-delete admin__trails-icon" 
							data-url="{{ path('app_trail_delete', {'id': trail.id}) }}" 
							data-token="{{ csrf_token('delete' ~ trail.id) }}" 
							data-name="{{ trail.name }}" 
							type="submit">
							{{ ux_icon('streamline-ultimate:bin-1-bold',{ class: 'admin__trails-icon' }) }}
						</button>
					</form>
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			{# GESTION DES WALKS #}
		
			<div  id="walks-list" class="admin__walks hidden">
				<h2 class="admin__walks-title">Balades</h2>
				<table class="admin__walks-table">
					<thead>
						<tr>
							<th>Date</th>
							<th>Itinéraire</th>
							<th>Chiens max</th>

							<th>Chiens inscrits</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for walk in walks %}
							<tr>
								<td data-label="Date">{{ walk.date|format_datetime('full', 'short', locale: 'fr') }}</td>
								<td data-label="Itinéraire">
									<a href="{{ path('app_trail_show', {'id': walk.trail.id})}}">{{ walk.trail.name }}</a>
								</td>
								<td data-label="Nombre de chiens maximum">{{ walk.maxDogs }}</td>

								<td data-label="Nombre d'inscriptions">{{ walk.walkRegistration|length }}</td>
								<td data-label="Actions">
									<div class="admin__walks-wrapper">
										<a class="admin__walks-icon" href="{{ path('app_walk_edit', {'id': walk.id}) }}">{{ ux_icon('fa:edit',{ class: 'admin__walks-edit-icon' }) }}</a>
										<form method="post" action="{{ path('app_walk_delete', {'id': walk.id}) }}">
											<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ walk.id) }}">
											<button class="js-delete admin__walks-icon" data-url="{{ path('app_walk_delete', {'id': walk.id}) }}" data-token="{{ csrf_token('delete' ~ walk.id) }}" data-name="La balade du {{ walk.date|format_datetime('short', 'short', locale: 'fr') }}" type="submit">
												{{ ux_icon('streamline-ultimate:bin-1-bold',{ class: 'admin__walks-icon' }) }}
											</button>
										</form>
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

	</section>
{% endblock %}
