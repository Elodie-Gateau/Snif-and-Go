{% extends 'base.html.twig' %}

{% block title %}Walk index
{% endblock %}

{% block body %}
	<section class="walks">
		<h2 class="walks__title">Les prochaines balades disponibles</h2>
		<div class="walks__container">
			{% if nextWalks|length > 0 %}
				{% for walk in nextWalks %}
					{% set availableSeats = walk.maxDogs - walk.walkRegistration|length %}
					{% if availableSeats > 0 %}
						<div class="walks__card">
							<div class="walks__wrapper">
								<p class="walks__accent">{{ walk.date|format_datetime('medium', 'short', locale: 'fr') }}</p>
								<a href="{{ path('app_trail_show', {id:walk.trail.id})}}" class="walks__link">
									<strong>{{ walk.trail.name }}</strong>
								</a>
							</p>
							<p class="walks__content">{{ walk.trail.startCity }}</p>
						</div>
						<div class="walks__wrapper">
							<a class="walks__button" href="{{ path('app_walk_registration_new', { walkId: walk.id }) }}">S'inscrire</a>
							<p class="walks__accent">{{ availableSeats }}
								place{{ availableSeats > 1 ? "s" : "" }}
								restante{{ availableSeats > 1 ? "s" : "" }}</p>
						</div>
					</div>
				{% endif %}
			{% endfor %}
		</div>
	{% else %}
		<p>Aucune balade prévue</p>
	{% endif %}
</section>{% endblock %}
