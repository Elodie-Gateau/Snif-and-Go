{% extends 'base.html.twig' %}

{% block title %}Modifier le profil de
	{{ dog.name }}
{% endblock %}

{% block body %}
	<section class="edit-dog">
		<h1 class="edit-dog__title">Modifier le profil de
			{{ dog.name }}</h1>

		{{ include('dog/_form.html.twig', {'button_label': 'Enregistrer'}) }}


		<div class="edit-dog__wrapper">
			<a class="edit-dog__back" href="{{ path('app_home') }}">Retour</a>
			<form method="post" class="edit-dog__form-delete" action="{{ path('app_dog_inactive', { 'id': dog.id }) }}">
				<button type="submit" class="edit-dog__button-delete">{{ ux_icon('streamline-ultimate:bin-1-bold', {'class': 'profile__dog-delete-icon'}) }}</button>
			</form>
		</div>
	</section>
{% endblock %}
