# --- Activer mod_rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Si le fichier demandé existe (image, css, js, font, etc.), le servir directement
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2) Sinon, on passe au front controller Symfony
  RewriteRule ^ index.php [L]
</IfModule>

# --- Expirations par type (ok en .htaccess)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif  "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css   "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
</IfModule>

# --- En-têtes Cache-Control (seulement ce qui est autorisé en .htaccess)
<IfModule mod_headers.c>
  # a) Fichiers fingerprintés (hash dans le nom) : cache très long + immutable
  <FilesMatch "\-[A-Za-z0-9]{6,}\.(?:css|js|mjs|woff2|webp|avif|svg|png|jpe?g|gif)$">
    Header unset Cache-Control
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # b) HTML : jamais mis en cache (toujours revalidé)
  <FilesMatch "\.(?:html)$">
    Header unset Cache-Control
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # c) Images/Uploads non fingerprintées : cache raisonnable 30 jours
  <FilesMatch "\.(?:avif|webp|jpe?g|png|gif)$">
    Header unset Cache-Control
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # d) JS/CSS non fingerprintés : cache 1 an
  <FilesMatch "\.(?:js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # d) Indique au cache les variantes encodage
  Header merge Vary Accept-Encoding

  # --- Normalize Permissions-Policy (avoid unknown features like 'browsing-topics')
  Header always unset Permissions-Policy
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
</IfModule>

# --- Compression (Brotli / Gzip)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS \
    text/html text/plain text/css text/javascript application/javascript \
    application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE \
    text/html text/plain text/css text/javascript application/javascript \
    application/x-javascript application/json image/svg+xml text/xml

  # Evite de recompresser les fichiers déjà compressés
  SetEnvIfNoCase Request_URI \.((gz|br))$ no-gzip

  # Force la compression pour les navigateurs
  <IfModule mod_setenvif.c>
    <IfModule mod_headers.c>
      SetEnvIfNoCase ^(Accept-EncodXng|X-cept-Encoding|X{15}|~{15}|-{15})$ ^((gzip|deflate)\s*,?\s*)+|[X~-]{4,13}$ HAVE_Accept-Encoding
      RequestHeader append Accept-Encoding "gzip,deflate" env=HAVE_Accept-Encoding
    </IfModule>
  </IfModule>
</IfModule>